@model CreditosApp.ViewModels.SolicitudCreditoCreateViewModel
@{
    ViewData["Title"] = "Nueva Solicitud";
}

<div class="mb-4">
    <h1 class="h2 mb-1">Nueva solicitud de crédito</h1>
    <p class="text-secondary mb-0">Registra una solicitud para uno de tus clientes activos.</p>
</div>

@if (TempData["ErrorMessage"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<form asp-controller="Solicitudes" asp-action="Create" method="post" class="card">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        @if (Model.Clientes.Count == 0)
        {
            <div class="alert alert-warning" role="alert">
                No tienes clientes activos registrados para esta solicitud.
            </div>
        }
        else
        {
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="ClienteId" class="form-label"></label>
                    <select asp-for="ClienteId" class="form-select">
                        <option value="">Selecciona un cliente</option>
                        @foreach (var cliente in Model.Clientes)
                        {
                            <option value="@cliente.Id">Cliente n.º @cliente.Id - Ingresos mensuales: @cliente.IngresosMensuales.ToString("C")</option>
                        }
                    </select>
                    <span asp-validation-for="ClienteId" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="MontoSolicitado" class="form-label"></label>
                    <input asp-for="MontoSolicitado" class="form-control" type="number" step="0.01" min="0.01" />
                    <span asp-validation-for="MontoSolicitado" class="text-danger"></span>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Registrar solicitud</button>
                <a asp-controller="Solicitudes" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        }
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
