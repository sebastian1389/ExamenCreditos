@model CreditosApp.Models.SolicitudCredito
@{
    ViewData["Title"] = $"Detalle de solicitud #{Model.Id}";
    var estadoClass = Model.Estado switch
    {
        EstadoSolicitud.Pendiente => "bg-warning text-dark",
        EstadoSolicitud.Aprobado => "bg-success",
        EstadoSolicitud.Rechazado => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Detalle de la solicitud</h1>
        <p class="text-secondary mb-0">Solicitud #@Model.Id</p>
    </div>
    <a asp-controller="Solicitudes" asp-action="Index" class="btn btn-outline-secondary">Volver a Mis Solicitudes</a>
</div>

<div class="card">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h2 class="h5 mb-0">Información de la solicitud</h2>
        <span class="badge @estadoClass">@Model.Estado</span>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Identificador</dt>
            <dd class="col-sm-8">@Model.Id</dd>

            <dt class="col-sm-4">Cliente</dt>
            <dd class="col-sm-8">
                @if (Model.Cliente is not null)
                {
                    <span>#@Model.Cliente.Id</span>
                }
                else
                {
                    <span>No disponible</span>
                }
            </dd>

            <dt class="col-sm-4">Usuario asociado</dt>
            <dd class="col-sm-8">@(Model.Cliente?.Usuario?.Email ?? "No disponible")</dd>

            <dt class="col-sm-4">Ingresos mensuales</dt>
            <dd class="col-sm-8">@(Model.Cliente?.IngresosMensuales.ToString("C") ?? "No disponible")</dd>

            <dt class="col-sm-4">Cliente activo</dt>
            <dd class="col-sm-8">@(Model.Cliente?.Activo == true ? "Sí" : "No")</dd>

            <dt class="col-sm-4">Monto solicitado</dt>
            <dd class="col-sm-8">@Model.MontoSolicitado.ToString("C")</dd>

            <dt class="col-sm-4">Fecha de solicitud</dt>
            <dd class="col-sm-8">@Model.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-4">Estado</dt>
            <dd class="col-sm-8">@Model.Estado</dd>

            <dt class="col-sm-4">Motivo de rechazo</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.MotivoRechazo) ? "No aplica" : Model.MotivoRechazo)</dd>
        </dl>
    </div>
</div>
