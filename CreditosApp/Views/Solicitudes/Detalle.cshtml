@model CreditosApp.Models.SolicitudCredito
@{
    ViewData["Title"] = $"Detalle de solicitud #{Model.Id}";
    var estadoClass = Model.Estado switch
    {
        EstadoSolicitud.Pendiente => "bg-warning text-dark",
        EstadoSolicitud.Aprobado => "bg-success",
        EstadoSolicitud.Rechazado => "bg-danger",
        _ => "bg-secondary"
    };
}

@if (TempData["SuccessMessage"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success" role="status">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Detalle de la solicitud</h1>
        <p class="text-secondary mb-0">Solicitud #@Model.Id</p>
    </div>
    <a asp-controller="Solicitudes" asp-action="Index" class="btn btn-outline-secondary">Volver a Mis Solicitudes</a>
</div>

<div data-solicitudes-realtime-container>
    <div class="d-flex align-items-center gap-2 mb-3" role="status" aria-live="polite">
        <span id="solicitudesRealtimeStatusIndicator" class="badge rounded-pill bg-secondary">Conectando</span>
        <span id="solicitudesRealtimeStatusText" class="small text-secondary">Conectando al canal de notificaciones...</span>
    </div>
    <div id="solicitudesRealtimeNotification" class="alert alert-info d-none" role="status" aria-live="polite"></div>
</div>

<div class="card" data-solicitud-realtime-detail="@Model.Id">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h2 class="h5 mb-0">Información de la solicitud</h2>
        <span id="solicitudEstadoBadge" class="badge @estadoClass" data-solicitud-estado>@Model.Estado</span>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Identificador</dt>
            <dd class="col-sm-8">@Model.Id</dd>

            <dt class="col-sm-4">Cliente</dt>
            <dd class="col-sm-8">
                @if (Model.Cliente is not null)
                {
                    <span>#@Model.Cliente.Id</span>
                }
                else
                {
                    <span>No disponible</span>
                }
            </dd>

            <dt class="col-sm-4">Usuario asociado</dt>
            <dd class="col-sm-8">@(Model.Cliente?.Usuario?.Email ?? "No disponible")</dd>

            <dt class="col-sm-4">Ingresos mensuales</dt>
            <dd class="col-sm-8">@(Model.Cliente?.IngresosMensuales.ToString("C") ?? "No disponible")</dd>

            <dt class="col-sm-4">Cliente activo</dt>
            <dd class="col-sm-8">@(Model.Cliente?.Activo == true ? "Sí" : "No")</dd>

            <dt class="col-sm-4">Monto solicitado</dt>
            <dd class="col-sm-8">@Model.MontoSolicitado.ToString("C")</dd>

            <dt class="col-sm-4">Fecha de solicitud</dt>
            <dd class="col-sm-8">@Model.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-4">Estado</dt>
            <dd class="col-sm-8" data-solicitud-estado-texto>@Model.Estado</dd>

            <dt class="col-sm-4">Motivo de rechazo</dt>
            <dd class="col-sm-8" data-solicitud-motivo-rechazo>@(string.IsNullOrWhiteSpace(Model.MotivoRechazo) ? "No aplica" : Model.MotivoRechazo)</dd>
        </dl>
    </div>
</div>

@if (User.IsInRole("Analista"))
{
    <div class="card mt-4">
        <div class="card-body">
            <h2 class="h5">Actualizar estado</h2>
            <form asp-controller="Solicitudes" asp-action="ActualizarEstado" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="mb-3">
                    <label for="estado" class="form-label">Estado</label>
                    <select id="estado" name="estado" class="form-select" data-solicitud-estado-select>
                        @foreach (var estado in Enum.GetValues<EstadoSolicitud>())
                        {
                            if (Model.Estado == estado)
                            {
                                <option value="@estado" selected>@estado</option>
                            }
                            else
                            {
                                <option value="@estado">@estado</option>
                            }
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label for="motivoRechazo" class="form-label">Motivo de rechazo</label>
                    <textarea id="motivoRechazo" name="motivoRechazo" class="form-textarea" rows="3" data-solicitud-motivo-rechazo-input>@Model.MotivoRechazo</textarea>
                </div>
                <button type="submit" class="btn btn-primary">Guardar estado</button>
            </form>
        </div>
    </div>
}
